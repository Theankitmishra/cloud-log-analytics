# Database Configuration (PostgreSQL / RDS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loganalytics
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# AWS Infrastructure Configuration
AWS_REGION=us-east-1
LOG_GROUP=/aws/cloud-log-analytics/app
LOG_LEVEL=INFO

# Anomaly Detection Parameters
WINDOW_MINUTES=5
CONTAMINATION=0.05
SEVERITY_THRESHOLD_CRITICAL=-0.7
SEVERITY_THRESHOLD_HIGH=-0.5

# AWS Secrets Manager & SNS (Lambda)
DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:cloud-log-analytics/db-credentials
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:cloud-log-analytics-alerts
